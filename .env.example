# Telegram Bot configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Group/channel ID to send alerts to (production)
TELEGRAM_GROUP_ID=your_group_id_here

# Group/channel ID used when running with --test flag
TELEGRAM_GROUP_ID_TEST=your_test_group_id_here

# Logging
LOG_LEVEL=INFO
LOG_LEVEL_OTHERS=WARNING
LOG_FORMAT=rich
